# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Define the email address of the super administrator who can see and modify all data.
ADMIN_EMAIL="loud878@gmail.com"

# SQL DATABASE CONFIGURATION
SQL_HOST="localhost"
SQL_USER="postgres"
SQL_PASSWORD="your_password"
SQL_DB_NAME="industrial_park"

# SQL DATABASE ADMIN CONFIGURATION (for migrations)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="your_password"

# Firebase Client configuration
VITE_FIREBASE_API_KEY=""

# Security configurations
JWT_SECRET=""

# SMTP Email Configuration
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@industrialpark.ir"


