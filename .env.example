# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Define the email address of the super administrator who can see and modify all data.
ADMIN_EMAIL="manamalat@gmail.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Industrial@2025"

# SQL DATABASE CONFIGURATION (Neon.tech / Supabase / PostgreSQL)
# Example: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@hostname/dbname?sslmode=require"
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
SQL_SSL="require"

# Firebase Client configuration
VITE_FIREBASE_API_KEY=""

# Security configurations
JWT_SECRET=""

# SMTP Email Configuration
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@industrialpark.ir"

# OBJECT STORAGE CONFIGURATION (Cloudflare R2 / AWS S3 / MinIO)
# Leave empty to use optimized local disk storage (/uploads)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_PUBLIC_URL=""

# WEB PUSH NOTIFICATIONS (VAPID)
# Generated automatically on startup if left empty
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:manamalat@gmail.com"
