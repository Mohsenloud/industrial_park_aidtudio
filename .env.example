# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Define the email address of the super administrator who can see and modify all data.
ADMIN_EMAIL="manamalat@gmail.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Industrial@2025"

# SQL DATABASE CONFIGURATION (Neon.tech / Supabase / PostgreSQL)
# Example: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@hostname/dbname?sslmode=require"
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
SQL_SSL="require"

# Firebase Client configuration
VITE_FIREBASE_API_KEY=""

# Security configurations
JWT_SECRET=""

# SMTP Email Configuration
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@industrialpark.ir"
